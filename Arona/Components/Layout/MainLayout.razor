@inherits LayoutComponentBase

<FluentStack Orientation="Orientation.Horizontal">
    <FluentNav Width="260px">
        <FluentNavItem Href="/Chat">
            聊天
        </FluentNavItem>
        <FluentNavItem Href="/Config">
            设置
        </FluentNavItem>
        <FluentNavItem Href="/History">
            对话历史
        </FluentNavItem>
        <FluentNavItem Href="/Facts">
            记忆管理
        </FluentNavItem>
        <FluentNavItem Href="/BlackList">
            黑名单管理
        </FluentNavItem>
    </FluentNav>
    @Body
</FluentStack>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isCollapsed;
    private bool isMobileOpen;

    private void ToggleCollapse() => isCollapsed = !isCollapsed;
    private void ToggleMobile() => isMobileOpen = !isMobileOpen;
    private void CloseMobile() => isMobileOpen = false;
}