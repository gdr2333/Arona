@page "/providers"
@rendermode InteractiveServer
@using Arona.Datas.Storage
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@inject MainDbContext DbContext
@inject ILogger<Providers> Logger

<PageTitle>供应商管理 - Arona</PageTitle>

<div class="config-page">
    <PageHeader Title="供应商管理" Description="API 供应商（Provider）包含接入凭证，其下可挂载多个聊天模型与嵌入模型。" />

    <table class="config-table">
        <thead>
            <tr>
                <th>Id</th>
                <th>名称</th>
                <th>ApiKey</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in providers)
            {
                var current = item;
                <tr>
                    <td class="config-key">@current.Id</td>
                    <td><FluentTextInput @bind-Value="current.Name" Style="width:100%;" /></td>
                    <td><FluentTextInput @bind-Value="current.ApiKey" Style="width:100%;" /></td>
                    <td class="config-actions">
                        <FluentButton OnClick="() => SaveProviderAsync(current)">保存</FluentButton>
                        <FluentButton OnClick="() => DeleteProviderAsync(current.Id)" Appearance="ButtonAppearance.Outline">删除</FluentButton>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <AddFormCard Title="添加供应商" Message="@message">
        <label>Id</label>
        <FluentTextInput @bind-Value="newId" Placeholder="供应商唯一标识" />
        <label>名称</label>
        <FluentTextInput @bind-Value="newName" Placeholder="显示名称" />
        <label>ApiKey</label>
        <FluentTextInput @bind-Value="newApiKey" Placeholder="API 密钥" />
        <FluentButton OnClick="AddProviderAsync" Appearance="ButtonAppearance.Primary" Disabled="string.IsNullOrWhiteSpace(newId)">添加</FluentButton>
    </AddFormCard>
</div>

@code {
    private List<ApiProvider> providers = [];
    private string newId = "";
    private string newName = "";
    private string newApiKey = "";
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("初始化供应商管理页面");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            providers = await DbContext.ApiProviders.AsNoTracking().OrderBy(p => p.Id).ToListAsync();
            Logger.LogDebug("加载供应商列表：{Count} 项", providers.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载供应商列表失败");
        }
    }

    private async Task SaveProviderAsync(ApiProvider item)
    {
        try
        {
            var entity = await DbContext.ApiProviders.FindAsync(item.Id);
            if (entity is null) return;
            entity.Name = item.Name;
            entity.ApiKey = item.ApiKey;
            await DbContext.SaveChangesAsync();
            Logger.LogInformation("更新供应商 {Key}", item.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "更新供应商 {Key} 失败", item.Id);
            message = $"保存失败: {ex.Message}";
        }
    }

    private async Task DeleteProviderAsync(string id)
    {
        message = "";
        try
        {
            var entity = await DbContext.ApiProviders.FindAsync(id);
            if (entity is null) return;
            DbContext.ApiProviders.Remove(entity);
            await DbContext.SaveChangesAsync();
            Logger.LogInformation("删除供应商 {Key}", id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "删除供应商 {Key} 失败", id);
            message = $"删除失败（可能存在关联模型）: {ex.Message}";
        }
    }

    private async Task AddProviderAsync()
    {
        message = "";
        var id = newId.Trim();
        if (string.IsNullOrWhiteSpace(id)) return;
        try
        {
            if (await DbContext.ApiProviders.AnyAsync(p => p.Id == id))
            {
                message = $"供应商 \"{id}\" 已存在。";
                return;
            }
            DbContext.ApiProviders.Add(new ApiProvider { Id = id, Name = newName, ApiKey = newApiKey });
            await DbContext.SaveChangesAsync();
            Logger.LogInformation("添加供应商 {Key}", id);
            newId = "";
            newName = "";
            newApiKey = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "添加供应商 {Key} 失败", id);
            message = $"添加失败: {ex.Message}";
        }
    }
}