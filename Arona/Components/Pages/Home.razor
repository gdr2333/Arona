@page "/"

@rendermode InteractiveServer

<PageTitle>Arona</PageTitle>

<div class="home-page">
    <div class="home-hero">
        <h1>A.R.O.N.A</h1>
        <p class="home-subtitle">AI Agent 管理系统</p>
    </div>
    <div class="home-cards">
        <a href="/chat" class="home-card">
            <div class="home-card-icon">💬</div>
            <h3>对话</h3>
            <p>与 Arona 对话</p>
        </a>
        <a href="/config" class="home-card">
            <div class="home-card-icon">⚙️</div>
            <h3>配置</h3>
            <p>管理系统配置项</p>
        </a>
        <a href="/providers" class="home-card">
            <div class="home-card-icon">🔌</div>
            <h3>供应商</h3>
            <p>API 供应商管理</p>
        </a>
        <a href="/models" class="home-card">
            <div class="home-card-icon">🤖</div>
            <h3>模型</h3>
            <p>聊天与嵌入模型</p>
        </a>
        <a href="/blacklist" class="home-card">
            <div class="home-card-icon">🚫</div>
            <h3>黑名单</h3>
            <p>群黑名单管理</p>
        </a>
    </div>
</div>