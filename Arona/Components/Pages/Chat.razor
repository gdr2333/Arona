@page "/Chat"
@using Arona.Datas.Storage
@using Arona.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging

@rendermode InteractiveServer

@inject AgentService AgentService
@inject MainDbContext DbContext
@inject INotificationService NotificationService
@inject ILogger<Chat> Logger

<PageTitle>聊天</PageTitle>

<FluentProviders />

<div class="chat-layout">
    <div class="chat-sidebar">
        <div class="chat-sidebar-head">
            <span class="chat-sidebar-title">会话</span>
            <FluentButton OnClick="NewSessionAsync" Appearance="ButtonAppearance.Subtle">+ 新建</FluentButton>
        </div>
        @foreach (var s in sessions)
        {
            <div class="session-item @(s.Id == currentSessionId ? "active" : "")" @onclick="() => SelectSessionAsync(s.Id)">
                <span class="session-name">@GetDisplayName(s.Id)</span>
                <span class="session-time">@(s.LastTime == DateTime.MinValue ? "空" : s.LastTime.ToLocalTime().ToString("MM-dd HH:mm"))</span>
            </div>
        }
        @if (sessions.Count == 0)
        {
            <p class="empty-inline">暂无会话</p>
        }
    </div>

    <div class="chat-container">
        <div class="chat-header">
            <div class="chat-title-group">
                <h2>@(currentSessionId is null ? "未选择会话" : GetDisplayName(currentSessionId))</h2>
            </div>
        </div>

        <div class="chat-messages">
            @if (currentSessionId is null)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">💬</div>
                    <p>点击左侧「+ 新建」开始对话</p>
                </div>
            }
            else
            {
                @foreach (var m in messages)
                {
                    <ChatMessageBubble Text="@m.Text" IsUser="@(m.Role == "user")" />
                }
                @if (isSending)
                {
                    <div class="chat-msg msg-agent">
                        <div class="msg-bubble msg-typing">正在思考…</div>
                    </div>
                }
            }
        </div>

        <ChatInputBar IsSending="isSending" OnSend="SendAsync" />
    </div>
</div>

@code
{
    private List<SessionListItem> sessions = [];
    private string? currentSessionId;
    private List<Msg> messages = [];
    private bool isSending;

    private class SessionListItem
    {
        public string Id { get; set; } = "";
        public DateTime LastTime { get; set; }
    }

    private record Msg(string Role, string Text);

    protected override async Task OnInitializedAsync()
    {
        await LoadSessionsAsync();
        if (sessions.Count > 0)
            await SelectSessionAsync(sessions[0].Id);
    }

    private static string GetDisplayName(string id) =>
        id.StartsWith("webui:") && id.Length > 14 ? "webui:" + id[6..14] : id;

    private async Task LoadSessionsAsync()
    {
        sessions = await DbContext.ChatSessions
            .Where(s => s.Id.StartsWith("webui:"))
            .Select(s => new SessionListItem
            {
                Id = s.Id,
                LastTime = s.Messages.Any() ? s.Messages.Max(m => m.UtcTime) : DateTime.MinValue
            })
            .OrderByDescending(s => s.LastTime)
            .AsNoTracking()
            .ToListAsync();
    }

    private async Task NewSessionAsync()
    {
        currentSessionId = $"webui:{Guid.NewGuid()}";
        DbContext.ChatSessions.Add(new ChatSession { Id = currentSessionId });
        await DbContext.SaveChangesAsync();
        messages = [];
        await LoadSessionsAsync();
    }

    private async Task SelectSessionAsync(string sessionId)
    {
        currentSessionId = sessionId;
        messages = await DbContext.ChatMessages
            .Where(m => m.SessionId == sessionId)
            .OrderBy(m => m.UtcTime)
            .Select(m => new Msg(m.Role, m.Message))
            .AsNoTracking()
            .ToListAsync();
    }

    private async Task SendAsync(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        if (currentSessionId is null)
            await NewSessionAsync();

        var sessionId = currentSessionId!;
        messages.Add(new Msg("user", text));
        isSending = true;
        StateHasChanged();

        try
        {
            var agent = AgentService.GetAgent(sessionId, ChatScenario.WebUI);
            var response = await agent.RunAsync(text);
            var contents = AgentTools.ExtractSendMessageContents(response.Messages);
            if (contents.Count == 0)
                messages.Add(new Msg("assistant", "（Agent 未回复）"));
            else
                foreach (var c in contents)
                    messages.Add(new Msg("assistant", c));
            await LoadSessionsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "发送消息失败");
            await NotificationService.ShowErrorToastAsync($"发送失败：{ex.Message}");
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }
}
