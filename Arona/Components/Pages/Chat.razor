@page "/chat"
@rendermode InteractiveServer
@using Arona.Datas.Storage
@using Arona.Services
@using Microsoft.Agents.AI
@using Microsoft.Extensions.AI
@using Microsoft.Extensions.Logging
@using Microsoft.EntityFrameworkCore
@inject AgentService AgentService
@inject MainDbContext DbContext
@inject ILogger<Chat> Logger

<PageTitle>对话 - Arona</PageTitle>

<div class="chat-layout">
    <div class="chat-sidebar">
        <FluentButton OnClick="NewSessionAsync" Appearance="ButtonAppearance.Primary" Style="width:100%;margin-bottom:.5rem;">+ 新建会话</FluentButton>
        @foreach (var s in SessionList)
        {
            var current = s;
            <div class="session-item @(current.Id == sessionId ? "active" : "")"
                 @onclick="() => SwitchSessionAsync(current.Id)">
                <span class="session-name">@current.DisplayName</span>
                <span class="session-time">@current.LastTime.ToString("MM-dd HH:mm")</span>
            </div>
        }
    </div>

    <div class="chat-container">
        <div class="chat-header">
            <h2>Arona 对话</h2>
            <label class="debug-toggle"><input type="checkbox" @bind="showDebug" /> 显示排障信息</label>
        </div>

        <div class="chat-messages" id="chat-scroll">
            @foreach (var msg in DisplayMessages)
            {
                if (msg.IsUser)
                {
                    <div class="chat-msg msg-user">
                        <div class="msg-bubble">@msg.Text</div>
                    </div>
                }
                else if (msg.IsDebug)
                {
                    if (showDebug)
                    {
                        <div class="chat-msg msg-debug">
                            <details>
                                <summary>排障 / 推理</summary>
                                <pre class="debug-text">@msg.Text</pre>
                            </details>
                        </div>
                    }
                }
                else
                {
                    <div class="chat-msg msg-agent">
                        <div class="msg-bubble">@msg.Text</div>
                    </div>
                }
            }
            @if (isSending)
            {
                <div class="chat-msg msg-agent">
                    <div class="msg-bubble msg-typing">思考中…</div>
                </div>
            }
        </div>

        <div class="chat-input">
            <FluentTextInput @bind-Value="inputText"
                             Placeholder="输入消息…"
                             @onkeydown="OnKeyDown"
                             Disabled="isSending"
                             Style="flex:1;" />
            <FluentButton OnClick="SendAsync" Disabled="isSending || string.IsNullOrWhiteSpace(inputText)">发送</FluentButton>
        </div>
    </div>
</div>

@code
{
    private string inputText = "";
    private bool isSending;
    private bool showDebug;
    private string sessionId = "";
    private readonly List<DisplayMessage> DisplayMessages = [];
    private readonly List<SessionItem> SessionList = [];

    private sealed class DisplayMessage
    {
        public required string Text { get; set; }
        public bool IsUser { get; set; }
        public bool IsDebug { get; set; }
    }

    private sealed class SessionItem
    {
        public required string Id { get; set; }
        public required string DisplayName { get; set; }
        public DateTime LastTime { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("初始化对话页面");
        await LoadSessionListAsync();
        if (SessionList.Count > 0)
        {
            await SwitchSessionAsync(SessionList[0].Id);
        }
        else
        {
            await NewSessionAsync();
        }
    }

    private async Task LoadSessionListAsync()
    {
        try
        {
            var sessionIds = await DbContext.ChatSessions
                .Where(s => s.Id.StartsWith("webui:"))
                .Select(s => s.Id)
                .ToListAsync();

            var lastTimes = await DbContext.ChatMessages
                .Where(m => sessionIds.Contains(m.SessionId))
                .GroupBy(m => m.SessionId)
                .Select(g => new { SessionId = g.Key, LastTime = g.Max(m => m.UtcTime) })
                .ToListAsync();

            var lastTimeMap = lastTimes.ToDictionary(x => x.SessionId, x => x.LastTime);

            SessionList.Clear();
            foreach (var id in sessionIds)
            {
                var last = lastTimeMap.TryGetValue(id, out var t) ? t : DateTime.UtcNow;
                SessionList.Add(new SessionItem
                {
                    Id = id,
                    DisplayName = id["webui:".Length..Math.Min(id.Length, "webui:".Length + 8)],
                    LastTime = last
                });
            }
            SessionList.Sort((a, b) => b.LastTime.CompareTo(a.LastTime));
            Logger.LogDebug("加载会话列表：{Count} 个会话", SessionList.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载会话列表失败");
        }
    }

    private async Task NewSessionAsync()
    {
        sessionId = "webui:" + Guid.NewGuid().ToString("N");
        DisplayMessages.Clear();
        Logger.LogInformation("新建会话 {Session}", sessionId);

        try
        {
            if (!await DbContext.ChatSessions.AnyAsync(s => s.Id == sessionId))
            {
                DbContext.ChatSessions.Add(new ChatSession { Id = sessionId });
                await DbContext.SaveChangesAsync();
            }
            await LoadSessionListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "新建会话 {Session} 持久化失败", sessionId);
        }
    }

    private async Task SwitchSessionAsync(string id)
    {
        if (id == sessionId && DisplayMessages.Count > 0)
            return;

        sessionId = id;
        DisplayMessages.Clear();
        Logger.LogInformation("切换到会话 {Session}", sessionId);

        try
        {
            var history = await DbContext.ChatMessages
                .Where(m => m.SessionId == sessionId)
                .OrderBy(m => m.UtcTime)
                .Select(m => new { m.Role, m.Message })
                .ToListAsync();

            foreach (var m in history)
            {
                DisplayMessages.Add(new DisplayMessage
                {
                    Text = m.Message,
                    IsUser = m.Role == "user",
                    IsDebug = false
                });
            }
            Logger.LogDebug("会话 {Session}：加载 {Count} 条历史消息", sessionId, history.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载会话 {Session} 历史失败", sessionId);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(inputText) || isSending)
            return;

        var text = inputText.Trim();
        inputText = "";
        isSending = true;

        DisplayMessages.Add(new DisplayMessage { Text = text, IsUser = true });
        Logger.LogInformation("会话 {Session}：发送消息 ({Length} 字符)", sessionId, text.Length);

        try
        {
            var agent = AgentService.GetAgent(sessionId, ChatScenario.WebUI);
            var response = await agent.RunAsync(text);

            var mainCount = 0;
            var debugCount = 0;
            foreach (var sent in AgentTools.ExtractSendMessageContents(response.Messages))
            {
                DisplayMessages.Add(new DisplayMessage { Text = sent, IsUser = false, IsDebug = false });
                mainCount++;
            }
            foreach (var msg in response.Messages)
            {
                foreach (var content in msg.Contents)
                {
                    if (content is TextContent tc && !string.IsNullOrWhiteSpace(tc.Text))
                    {
                        DisplayMessages.Add(new DisplayMessage { Text = tc.Text, IsUser = false, IsDebug = true });
                        debugCount++;
                    }
                }
            }
            Logger.LogDebug("会话 {Session}：响应解析完成，主消息 {Main} 条，排障 {Debug} 条", sessionId, mainCount, debugCount);

            await LoadSessionListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "会话 {Session}：发送消息时出错", sessionId);
            DisplayMessages.Add(new DisplayMessage { Text = $"错误: {ex.Message}", IsUser = false, IsDebug = true });
        }
        finally
        {
            isSending = false;
        }
    }
}