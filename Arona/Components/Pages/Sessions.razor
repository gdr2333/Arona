@page "/sessions"
@rendermode InteractiveServer
@using Arona.Datas.Storage
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@inject MainDbContext DbContext
@inject ILogger<Sessions> Logger

<PageTitle>会话管理 - Arona</PageTitle>

<div class="config-page">
    <PageHeader Title="会话管理" Description="查看与管理所有对话会话（WebUI / 私聊 / 群聊）。删除会话将同时删除其全部消息与会话专属记忆。" />

    <div class="filter-bar">
        <div class="filter-tabs">
            @foreach (var f in new[] { "全部", "WebUI", "私聊", "群聊", "其他" })
            {
                var current = f;
                <button class="filter-tab @(scenarioFilter == current ? "active" : "")" @onclick="() => scenarioFilter = current">@current</button>
            }
        </div>
        <FluentTextInput @bind-Value="searchText" Placeholder="搜索会话 ID…" Style="max-width:240px;" />
    </div>

    @if (FilteredSessions.Any())
    {
        <table class="config-table">
            <thead>
                <tr>
                    <th>会话 ID</th>
                    <th>场景</th>
                    <th>消息数</th>
                    <th>最后活动</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in FilteredSessions)
                {
                    var current = s;
                    <tr>
                        <td class="config-key">@current.Id</td>
                        <td><span class="scenario-badge @GetScenarioClass(current.Id)">@current.Scenario</span></td>
                        <td>@current.MessageCount</td>
                        <td>@(current.MessageCount > 0 ? current.LastTime.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                        <td class="config-actions">
                            <FluentButton OnClick="() => ToggleExpandAsync(current.Id)">@(expandedSessionId == current.Id ? "收起" : "查看")</FluentButton>
                            <FluentButton OnClick="() => DeleteSessionAsync(current.Id)" Appearance="ButtonAppearance.Outline">删除</FluentButton>
                        </td>
                    </tr>
                    @if (expandedSessionId == current.Id)
                    {
                        <tr class="history-row">
                            <td colspan="5">
                                <div class="session-history">
                                    @if (expandedHistory.Count == 0)
                                    {
                                        <p class="empty-inline">该会话暂无消息记录。</p>
                                    }
                                    else
                                    {
                                        @foreach (var m in expandedHistory)
                                        {
                                            <div class="history-msg">
                                                <span class="history-role">@m.Role · @m.UtcTime.ToString("MM-dd HH:mm")</span>
                                                <div class="history-text">@m.Message</div>
                                            </div>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">💬</div>
            <p>没有符合条件的会话</p>
        </div>
    }
</div>

@code {
    private string scenarioFilter = "全部";
    private string searchText = "";
    private string? expandedSessionId;
    private List<SessionRow> SessionList = [];
    private List<HistoryEntry> expandedHistory = [];

    private sealed class SessionRow
    {
        public required string Id { get; set; }
        public required string Scenario { get; set; }
        public int MessageCount { get; set; }
        public DateTime LastTime { get; set; }
    }

    private sealed class HistoryEntry
    {
        public required string Role { get; set; }
        public required string Message { get; set; }
        public DateTime UtcTime { get; set; }
    }

    private IEnumerable<SessionRow> FilteredSessions => SessionList
        .Where(s => scenarioFilter == "全部" || s.Scenario == scenarioFilter)
        .Where(s => string.IsNullOrWhiteSpace(searchText) || s.Id.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase));

    private static string GetScenario(string id) => id switch
    {
        _ when id.StartsWith("webui:") => "WebUI",
        _ when id.Contains(":private:") => "私聊",
        _ when id.Contains(":group:") => "群聊",
        _ => "其他"
    };

    private static string GetScenarioClass(string id) => id switch
    {
        _ when id.StartsWith("webui:") => "sc-webui",
        _ when id.Contains(":private:") => "sc-private",
        _ when id.Contains(":group:") => "sc-group",
        _ => "sc-other"
    };

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("初始化会话管理页面");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var sessionIds = await DbContext.ChatSessions.Select(s => s.Id).ToListAsync();

            var stats = await DbContext.ChatMessages
                .GroupBy(m => m.SessionId)
                .Select(g => new { SessionId = g.Key, Count = g.Count(), LastTime = g.Max(m => m.UtcTime) })
                .ToListAsync();
            var statMap = stats.ToDictionary(x => x.SessionId);

            SessionList = sessionIds
                .Select(id => new SessionRow
                {
                    Id = id,
                    Scenario = GetScenario(id),
                    MessageCount = statMap.TryGetValue(id, out var st) ? st.Count : 0,
                    LastTime = statMap.TryGetValue(id, out var st2) ? st2.LastTime : DateTime.MinValue
                })
                .OrderByDescending(s => s.LastTime)
                .ToList();
            Logger.LogDebug("加载会话：{Count} 个", SessionList.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载会话列表失败");
        }
    }

    private async Task ToggleExpandAsync(string id)
    {
        if (expandedSessionId == id)
        {
            expandedSessionId = null;
            expandedHistory = [];
            return;
        }
        expandedSessionId = id;
        try
        {
            expandedHistory = await DbContext.ChatMessages
                .Where(m => m.SessionId == id)
                .OrderBy(m => m.UtcTime)
                .Select(m => new HistoryEntry { Role = m.Role, Message = m.Message, UtcTime = m.UtcTime })
                .ToListAsync();
            Logger.LogDebug("展开会话 {Session}：{Count} 条消息", id, expandedHistory.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载会话 {Session} 历史失败", id);
        }
    }

    private async Task DeleteSessionAsync(string id)
    {
        try
        {
            DbContext.ChatMessages.RemoveRange(DbContext.ChatMessages.Where(m => m.SessionId == id));
            DbContext.Facts.RemoveRange(DbContext.Facts.Where(f => f.SessionId == id));
            var session = await DbContext.ChatSessions.FindAsync(id);
            if (session is not null) DbContext.ChatSessions.Remove(session);
            await DbContext.SaveChangesAsync();
            Logger.LogInformation("删除会话 {Session}（含消息与专属记忆）", id);
            if (expandedSessionId == id)
            {
                expandedSessionId = null;
                expandedHistory = [];
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "删除会话 {Session} 失败", id);
        }
    }
}