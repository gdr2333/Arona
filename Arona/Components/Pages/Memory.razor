@page "/memory"
@rendermode InteractiveServer
@using Arona.Datas.Storage
@using Arona.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@inject MainDbContext DbContext
@inject EmbeddingService EmbeddingService
@inject ILogger<Memory> Logger

<PageTitle>记忆管理 - Arona</PageTitle>

<div class="config-page">
    <PageHeader Title="记忆管理" Description="管理 Agent 的事实记忆（Fact）。全局 Fact 对所有会话可见，会话专属 Fact 仅对该会话可见。" />

    <div class="filter-bar">
        <div class="filter-tabs">
            @foreach (var f in new[] { "全部", "全局", "会话专属" })
            {
                var current = f;
                <button class="filter-tab @(scopeFilter == current ? "active" : "")" @onclick="() => scopeFilter = current">@current</button>
            }
        </div>
        <FluentTextInput @bind-Value="searchText" Placeholder="搜索内容…" Style="max-width:240px;" />
    </div>

    @if (FilteredFacts.Any())
    {
        <table class="config-table">
            <thead>
                <tr>
                    <th style="width:60px;">ID</th>
                    <th>内容</th>
                    <th style="width:80px;">范围</th>
                    <th>关联会话</th>
                    <th style="width:140px;">时间</th>
                    <th style="width:80px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in FilteredFacts)
                {
                    var current = f;
                    <tr>
                        <td class="config-key">@current.Id</td>
                        <td>
                            <div class="fact-content @(expandedFactId == current.Id ? "expanded" : "")"
                                 @onclick="() => expandedFactId = expandedFactId == current.Id ? null : current.Id">
                                @current.Content
                            </div>
                        </td>
                        <td><span class="scenario-badge @(current.SessionId is null ? "sc-global" : "sc-session")">@(current.SessionId is null ? "全局" : "会话")</span></td>
                        <td class="config-key">@(current.SessionId ?? "—")</td>
                        <td>@current.UtcTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="config-actions">
                            <FluentButton OnClick="() => DeleteFactAsync(current.Id)" Appearance="ButtonAppearance.Outline">删除</FluentButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">🧠</div>
            <p>没有符合条件的记忆</p>
        </div>
    }

    <AddFormCard Title="添加记忆" Message="@message">
        <label>内容</label>
        <FluentTextArea @bind-Value="newContent" Rows="4" Style="width:100%;" Placeholder="输入 Fact 内容…" />
        <label>范围</label>
        <select @bind="addScope" class="config-select">
            <option value="global">全局（所有会话可见）</option>
            <option value="session">会话专属</option>
        </select>
        @if (addScope == "session")
        {
            <label>目标会话</label>
            <select @bind="addSessionId" class="config-select">
                <option value="">— 选择会话 —</option>
                @foreach (var sid in sessionOptions)
                {
                    <option value="@sid">@sid</option>
                }
            </select>
        }
        <FluentButton OnClick="AddFactAsync" Appearance="ButtonAppearance.Primary" Disabled="@AddDisabled">添加</FluentButton>
    </AddFormCard>
</div>

@code {
    private string scopeFilter = "全部";
    private string searchText = "";
    private long? expandedFactId;
    private string message = "";

    private string newContent = "";
    private string addScope = "global";
    private string addSessionId = "";

    private bool AddDisabled => string.IsNullOrWhiteSpace(newContent) || (addScope == "session" && string.IsNullOrWhiteSpace(addSessionId));

    private List<FactRow> FactList = [];
    private List<string> sessionOptions = [];

    private sealed class FactRow
    {
        public long Id { get; set; }
        public string Content { get; set; } = "";
        public string? SessionId { get; set; }
        public DateTime UtcTime { get; set; }
    }

    private IEnumerable<FactRow> FilteredFacts => FactList
        .Where(f => scopeFilter switch
        {
            "全局" => f.SessionId is null,
            "会话专属" => f.SessionId is not null,
            _ => true
        })
        .Where(f => string.IsNullOrWhiteSpace(searchText) || f.Content.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("初始化记忆管理页面");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            FactList = await DbContext.Facts
                .OrderByDescending(f => f.UtcTime)
                .Select(f => new FactRow { Id = f.Id, Content = f.Content, SessionId = f.SessionId, UtcTime = f.UtcTime })
                .ToListAsync();

            sessionOptions = await DbContext.ChatSessions.Select(s => s.Id).OrderBy(s => s).ToListAsync();
            Logger.LogDebug("加载记忆：{Count} 条 Fact，{Sessions} 个会话", FactList.Count, sessionOptions.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "加载记忆列表失败");
        }
    }

    private async Task DeleteFactAsync(long id)
    {
        message = "";
        try
        {
            var fact = await DbContext.Facts.FindAsync(id);
            if (fact is null) return;
            DbContext.Facts.Remove(fact);
            await DbContext.SaveChangesAsync();
            Logger.LogInformation("删除 Fact {Id}", id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "删除 Fact {Id} 失败", id);
            message = $"删除失败: {ex.Message}";
        }
    }

    private async Task AddFactAsync()
    {
        message = "";
        var content = newContent.Trim();
        if (string.IsNullOrWhiteSpace(content))
            return;

        if (addScope == "session" && string.IsNullOrWhiteSpace(addSessionId))
        {
            message = "请选择目标会话。";
            return;
        }

        try
        {
            var embedding = await EmbeddingService.ComputeAsync(content);
            var sessionId = addScope == "global" ? null : addSessionId;
            DbContext.Facts.Add(new Fact
            {
                Content = content,
                Embedding = embedding,
                UtcTime = DateTime.UtcNow,
                SessionId = sessionId
            });
            await DbContext.SaveChangesAsync();
            Logger.LogInformation("添加 Fact：scope={Scope}, session={Session}", addScope, sessionId);
            newContent = "";
            addSessionId = "";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "添加 Fact 失败");
            message = $"添加失败: {ex.Message}";
        }
    }
}