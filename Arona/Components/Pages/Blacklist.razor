@page "/blacklist"
@rendermode InteractiveServer
@using Arona.Services
@using Microsoft.Extensions.Logging
@inject GroupBlacklistService BlacklistService
@inject ILogger<Blacklist> Logger

<PageTitle>群黑名单 - Arona</PageTitle>

<div class="config-page">
    <h2>群黑名单管理</h2>
    <p class="config-hint">黑名单中的群将不处理任何消息。黑名单外的群，Bot 会收到所有消息并自主决定是否回复。</p>

    @if (groups.Count == 0)
    {
        <p class="config-message">当前黑名单为空。</p>
    }
    else
    {
        <table class="config-table">
            <thead>
                <tr>
                    <th>群 ID</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var gid in groups)
                {
                    var current = gid;
                    <tr>
                        <td class="config-key">@current</td>
                        <td class="config-actions">
                            <FluentButton OnClick="() => RemoveAsync(current)" Appearance="ButtonAppearance.Outline">移除</FluentButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="config-add">
        <h3>添加群到黑名单</h3>
        <div class="config-add-form">
            <label>群 ID</label>
            <FluentTextInput @bind-Value="newGroupId" Placeholder="要拉黑的群号" />
            <FluentButton OnClick="AddAsync" Appearance="ButtonAppearance.Primary" Disabled="!CanParseId">添加</FluentButton>
        </div>
        @if (!string.IsNullOrEmpty(message))
        {
            <p class="config-message">@message</p>
        }
    </div>
</div>

@code
{
    private List<long> groups = [];
    private string newGroupId = "";
    private string message = "";

    private bool CanParseId => long.TryParse(newGroupId.Trim(), out var id) && id > 0;

    protected override void OnInitialized()
    {
        Logger.LogInformation("初始化群黑名单管理页面");
        Reload();
    }

    private void Reload()
    {
        groups = BlacklistService.GetAll().OrderBy(g => g).ToList();
        Logger.LogDebug("加载黑名单：{Count} 项", groups.Count);
    }

    private async Task AddAsync()
    {
        message = "";
        if (!long.TryParse(newGroupId.Trim(), out var id) || id <= 0)
        {
            message = "请输入有效的群 ID（正整数）。";
            return;
        }
        var added = await BlacklistService.AddAsync(id);
        if (added)
        {
            Logger.LogInformation("添加群 {GroupId} 到黑名单", id);
            newGroupId = "";
        }
        else
        {
            message = $"群 {id} 已在黑名单中。";
        }
        Reload();
    }

    private async Task RemoveAsync(long id)
    {
        message = "";
        await BlacklistService.RemoveAsync(id);
        Logger.LogInformation("从黑名单移除群 {GroupId}", id);
        Reload();
    }
}