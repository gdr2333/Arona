@page "/BlackList"

@rendermode InteractiveServer

@using Arona.Services
@using Microsoft.Extensions.Logging
@inject GroupBlacklistService BlacklistService
@inject ILogger<Blacklist> Logger
@inject INotificationService NotificationService

<PageTitle>黑名单管理</PageTitle>

<FluentProviders />

<FluentStack Orientation="Orientation.Vertical">
    <h1>黑名单管理</h1>
    <p>黑名单内的群接收到的消息将被忽略</p>
    <FluentStack Orientation="Orientation.Horizontal">
        <FluentTextInput TextInputType="TextInputType.Number" Label="要拉黑的群号" @bind-Value="bannedGroupId"/>
        <FluentButton OnClick="AddAsync">添加到黑名单</FluentButton>
    </FluentStack>
    <FluentDataGrid 
        GenerateHeader="DataGridGeneratedHeaderType.None"
        DisplayMode="DataGridDisplayMode.Table"
        TGridItem="string"
        role="grid">
        <FluentDataGridRow RowType="DataGridRowType.Header">
            <FluentDataGridCell 
                GridColumn="1" 
                CellType="DataGridCellType.ColumnHeader">
                群号
            </FluentDataGridCell>
            <FluentDataGridCell 
                GridColumn="2" 
                CellType="DataGridCellType.ColumnHeader">
                操作
            </FluentDataGridCell>
        </FluentDataGridRow>
        @foreach(var i in groups)
        {
            <FluentDataGridRow>
                <FluentDataGridCell GridColumn="1">
                    @i
                </FluentDataGridCell>
                <FluentDataGridCell GridColumn="2">
                    <FluentButton OnClick="@(async e => await RemoveAsync(i))">
                        删除
                    </FluentButton>
                </FluentDataGridCell>
            </FluentDataGridRow>
        }
    </FluentDataGrid>
</FluentStack>

@code
{
    public string bannedGroupId { get; set; } = "";
    private List<long> groups = [];

    protected override void OnInitialized()
    {
        Logger.LogInformation("初始化群黑名单管理页面");
        Reload();
        base.OnInitialized();
    }

    private void Reload()
    {
        groups = BlacklistService.GetAll().OrderBy(g => g).ToList();
        Logger.LogDebug("加载黑名单：{Count} 项", groups.Count);
    }

    private async Task AddAsync()
    {
        if (!long.TryParse(bannedGroupId.Trim(), out var id) || id <= 0)
        {
            await NotificationService.ShowErrorToastAsync("请输入有效的群 ID（正整数）。");
            return;
        }
        var added = await BlacklistService.AddAsync(id);
        if (added)
        {
            await NotificationService.ShowInfoToastAsync($"添加群 {id} 到黑名单");
            bannedGroupId = "";
        }
        else
        {
            await NotificationService.ShowErrorToastAsync($"群 {id} 已在黑名单中。");
        }
        Reload();
    }

    private async Task RemoveAsync(long id)
    {
        await BlacklistService.RemoveAsync(id);
        Logger.LogInformation("从黑名单移除群 {GroupId}", id);
        Reload();
    }
}